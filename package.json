{
  "name": "demoputter",
  "version": "0.2.0",
  "description": "A developer workspace for repositories: files, commits, PRs, issues, actions.",
  "main": "main.js",
  "author": "wuyixiao123",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.wuyixiao123.demoputter",
    "productName": "demoputter",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "app.js",
      "README.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "demoputter"
    }
  }
}
